    classDef future fill:#7a7a7a,stroke:#4d4d4d,color:#fff,stroke-dasharray: 5 5;
    class PHYS,DESKTOP,SERIAL,DOMAIN,APP,INFRA,CONTRACTS,CLOUDAPI,CLOUDAPP,CLOUDDOMAIN,CLOUDINFRA,PG_DOCKER,PG_NEON,DOCKERHOST current;
    class RENDER,RENDERAPI future;
