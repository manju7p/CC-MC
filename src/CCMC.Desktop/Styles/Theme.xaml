    <!-- ================= Secondary-window header ================= -->
    <!-- Consistent icon + title + optional subtitle strip at the top of every non-shell
         window (Reception, History, Sources, Vehicles, Device Configuration/Status, Sync
         Status, Settings) - gives every window a shared identity instead of each one
         inventing its own header layout. -->
    <Style x:Key="WindowHeaderBorder" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource ElevatedSurfaceBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush1}"/>
        <Setter Property="BorderThickness" Value="0,0,0,1"/>
        <Setter Property="Padding" Value="24,18"/>
    </Style>

    <Style x:Key="WindowHeaderIconText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource IconFontFamily}"/>
        <Setter Property="FontSize" Value="22"/>
        <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}"/>
        <Setter Property="Margin" Value="0,0,14,0"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <!-- ================= Empty / loading state ================= -->
    <Style x:Key="EmptyStateBorder" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource BackgroundBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush1}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="6"/>
        <Setter Property="Padding" Value="32"/>
    </Style>

    <Style x:Key="EmptyStateIconText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource IconFontFamily}"/>
        <Setter Property="FontSize" Value="30"/>
        <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="Margin" Value="0,0,0,10"/>
    </Style>

    <Style x:Key="EmptyStateTitleText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="TextAlignment" Value="Center"/>
    </Style>

    <Style x:Key="EmptyStateBodyText" TargetType="TextBlock" BasedOn="{StaticResource CaptionText}">
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="TextAlignment" Value="Center"/>
        <Setter Property="Margin" Value="0,4,0,0"/>
        <Setter Property="MaxWidth" Value="420"/>
    </Style>

    <!-- ================= Search box ================= -->
    <Style x:Key="SearchTextBox" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
        <Setter Property="Padding" Value="30,6,10,6"/>
    </Style>

    <Style TargetType="ScrollViewer">
        <Setter Property="Background" Value="Transparent"/>
    </Style>

</ResourceDictionary>
