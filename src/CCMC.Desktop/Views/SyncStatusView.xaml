<UserControl x:Class="CCMC.Desktop.Views.SyncStatusView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource WindowHeaderBorder}">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#xE895;" Style="{StaticResource WindowHeaderIconText}"/>
                <TextBlock Text="Synchronization Status" Style="{StaticResource TitleText}" VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="1" Margin="24">
            <Border Style="{StaticResource CardBorder}">
                <StackPanel>
                    <TextBlock Text="PENDING" Style="{StaticResource SectionLabelText}" Margin="0,0,0,10"/>
                    <StackPanel Name="PendingHost" Orientation="Horizontal" Margin="0,0,0,16"/>

                    <Button Name="SyncNowButton" Height="38" Style="{StaticResource PrimaryButton}" Click="SyncNowButton_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE895;" Style="{StaticResource InlineIconText}" Margin="0,0,6,0"/>
                            <TextBlock Text="Sync Now"/>
                        </StackPanel>
                    </Button>

                    <TextBlock Name="LastTickTextBlock" TextWrapping="Wrap" Style="{StaticResource CaptionText}" Margin="0,14,0,0"/>
                    <TextBlock Name="NoSessionHintTextBlock" Foreground="{StaticResource WarningBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,14,0,0"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </Grid>
</UserControl>
