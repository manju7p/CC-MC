<UserControl x:Class="CCMC.Desktop.Views.ReceptionHistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <!-- One transaction row, rendered as a card-like Grid rather than a raw DataGrid line -
             see this redesign's "do not make History look like Excel" requirement. Column
             widths mirror ColumnHeaderRow below so labels and data always line up. -->
        <DataTemplate x:Key="HistoryRowTemplate">
            <Border Style="{StaticResource AlternatingRowBorder}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*" MinWidth="150"/>
                        <ColumnDefinition Width="1.3*" MinWidth="110"/>
                        <ColumnDefinition Width="1.6*" MinWidth="150"/>
                        <ColumnDefinition Width="1.2*" MinWidth="110"/>
                        <ColumnDefinition Width="1.2*" MinWidth="110"/>
                        <ColumnDefinition Width="1*" MinWidth="100"/>
                        <ColumnDefinition Width="1.1*" MinWidth="120"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding SourceName}" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding VehicleNumber}" Style="{StaticResource CaptionText}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding TransactionLabel}" FontSize="12"/>
                        <TextBlock Text="{Binding CapturedText}" Style="{StaticResource CaptionText}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                        <TextBlock Text="{Binding QuantityText}" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding QualityText}" Style="{StaticResource CaptionText}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="3" VerticalAlignment="Center">
                        <TextBlock Text="{Binding RateText}" Style="{StaticResource CaptionText}"/>
                        <TextBlock Text="{Binding AmountText}" FontWeight="SemiBold" Foreground="{StaticResource PrimaryDarkBrush}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="4" VerticalAlignment="Center">
                        <Border Style="{Binding ReadingSourceChipStyle}" HorizontalAlignment="Left">
                            <TextBlock Text="{Binding ReadingSourceText}" Style="{Binding ReadingSourceTextStyle}"/>
                        </Border>
                        <TextBlock Text="{Binding ReasonText}" Style="{StaticResource CaptionText}" Margin="0,3,0,0"
                                   Visibility="{Binding ReasonVisibility}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="5" VerticalAlignment="Center">
                        <Border Style="{Binding StatusChipBorderStyle}" HorizontalAlignment="Left">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding StatusGlyph}" Style="{Binding StatusChipIconStyle}"/>
                                <TextBlock Text="{Binding StatusText}" Style="{Binding StatusChipTextStyle}"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <StackPanel Grid.Column="6" VerticalAlignment="Center">
                        <TextBlock Text="{Binding SyncText}" Style="{StaticResource CaptionText}"/>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Style="{StaticResource WindowHeaderBorder}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE917;" Style="{StaticResource WindowHeaderIconText}"/>
                    <StackPanel>
                        <TextBlock Text="Reception History" Style="{StaticResource TitleText}"/>
                        <TextBlock Text="Locally captured receptions." Style="{StaticResource CaptionText}"/>
                    </StackPanel>
                </StackPanel>
                <Button Grid.Column="1" Name="RefreshButton" Style="{StaticResource SecondaryButton}" Click="RefreshButton_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE72C;" Style="{StaticResource InlineIconText}" Margin="0,0,6,0"/>
                        <TextBlock Text="Refresh"/>
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="24">

                <!-- KPI summary - computed from the currently loaded set, never invented. -->
                <UniformGrid Name="SummaryCardsPanel" Columns="4" Margin="0,0,0,10">
                    <Border Style="{StaticResource CardBorder}" Margin="0,0,10,0">
                        <StackPanel>
                            <TextBlock Text="RECEPTIONS" Style="{StaticResource SectionLabelText}"/>
                            <TextBlock Name="TotalCountTextBlock" Text="—" Style="{StaticResource MetricValueText}" Margin="0,6,0,0"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource CardBorder}" Margin="0,0,10,0">
                        <StackPanel>
                            <TextBlock Text="TOTAL QUANTITY (KG)" Style="{StaticResource SectionLabelText}"/>
                            <TextBlock Name="TotalQuantityTextBlock" Text="—" Style="{StaticResource MetricValueText}" Margin="0,6,0,0"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource CardBorder}" Margin="0,0,10,0">
                        <StackPanel>
                            <TextBlock Text="TOTAL AMOUNT" Style="{StaticResource SectionLabelText}"/>
                            <TextBlock Name="TotalAmountTextBlock" Text="—" Style="{StaticResource MetricValueText}" Margin="0,6,0,0"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource CardBorder}">
                        <StackPanel>
                            <TextBlock Text="ACCEPTED / HOLD / REJECTED" Style="{StaticResource SectionLabelText}"/>
                            <TextBlock Name="StatusBreakdownTextBlock" Text="— / — / —" FontSize="20" FontWeight="SemiBold" Margin="0,6,0,0"/>
                        </StackPanel>
                    </Border>
                </UniformGrid>

                <!-- Filters -->
                <Border Style="{StaticResource CardBorder}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="14"/>
                            <ColumnDefinition Width="180"/>
                            <ColumnDefinition Width="14"/>
                            <ColumnDefinition Width="180"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="SEARCH" Style="{StaticResource FieldLabelText}"/>
                            <TextBox Name="SearchTextBox" Style="{StaticResource SearchTextBox}" Tag="&#xE721;" TextChanged="Filter_Changed"
                                     ToolTip="Search by source, vehicle, transaction #, quantity, fat, SNF, rate, amount, status, and more"
                                     AutomationProperties.Name="Search reception history"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="PERIOD" Style="{StaticResource FieldLabelText}"/>
                            <ComboBox Name="DatePeriodComboBox" SelectionChanged="Filter_Changed"
                                      AutomationProperties.Name="Filter reception history by date period"
                                      ToolTip="Filter by Today/Past Week/Past Month/Past Year/Total"/>
                        </StackPanel>
                        <StackPanel Grid.Column="4">
                            <TextBlock Text="STATUS" Style="{StaticResource FieldLabelText}"/>
                            <ComboBox Name="StatusFilterComboBox" SelectionChanged="Filter_Changed"
                                      AutomationProperties.Name="Filter reception history by status"
                                      ToolTip="Filter by ACCEPT/HOLD/REJECT status"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Column header labels - widths mirror HistoryRowTemplate above. -->
                <Border Style="{StaticResource ListHeaderBorder}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*" MinWidth="150"/>
                            <ColumnDefinition Width="1.3*" MinWidth="110"/>
                            <ColumnDefinition Width="1.6*" MinWidth="150"/>
                            <ColumnDefinition Width="1.2*" MinWidth="110"/>
                            <ColumnDefinition Width="1.2*" MinWidth="110"/>
                            <ColumnDefinition Width="1*" MinWidth="100"/>
                            <ColumnDefinition Width="1.1*" MinWidth="120"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="SOURCE / VEHICLE" Style="{StaticResource SectionLabelText}"/>
                        <TextBlock Grid.Column="1" Text="TRANSACTION" Style="{StaticResource SectionLabelText}"/>
                        <TextBlock Grid.Column="2" Text="QUANTITY / QUALITY" Style="{StaticResource SectionLabelText}"/>
                        <TextBlock Grid.Column="3" Text="RATE / AMOUNT" Style="{StaticResource SectionLabelText}"/>
                        <TextBlock Grid.Column="4" Text="READING" Style="{StaticResource SectionLabelText}"/>
                        <TextBlock Grid.Column="5" Text="STATUS" Style="{StaticResource SectionLabelText}"/>
                        <TextBlock Grid.Column="6" Text="SYNC" Style="{StaticResource SectionLabelText}"/>
                    </Grid>
                </Border>

                <Border Style="{StaticResource ListContainerBorder}" Margin="0,0,0,14">
                    <StackPanel>
                        <ItemsControl Name="RowsItemsControl" ItemTemplate="{StaticResource HistoryRowTemplate}"/>

                        <Border Name="EmptyStatePanel" Style="{StaticResource EmptyStateBorder}" BorderThickness="0" Visibility="Collapsed">
                            <StackPanel>
                                <TextBlock Text="&#xE917;" Style="{StaticResource EmptyStateIconText}"/>
                                <TextBlock Text="No reception records yet" Style="{StaticResource EmptyStateTitleText}"/>
                                <TextBlock Style="{StaticResource EmptyStateBodyText}"
                                           Text="Receptions you capture on the Milk Reception screen will appear here, along with their quality decision, rate, and sync status."/>
                            </StackPanel>
                        </Border>

                        <Border Name="NoMatchesPanel" Style="{StaticResource EmptyStateBorder}" BorderThickness="0" Visibility="Collapsed">
                            <StackPanel>
                                <TextBlock Text="&#xE721;" Style="{StaticResource EmptyStateIconText}"/>
                                <TextBlock Text="No receptions match this filter" Style="{StaticResource EmptyStateTitleText}"/>
                                <TextBlock Style="{StaticResource EmptyStateBodyText}"
                                           Text="Try clearing the search text, choosing a different period, or choosing a different status."/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
