<Window x:Class="CCMC.Desktop.Windows.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CCMC - Settings" Height="460" Width="580" MinHeight="400" MinWidth="480"
        WindowStartupLocation="CenterOwner">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource WindowHeaderBorder}">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#xE946;" Style="{StaticResource WindowHeaderIconText}"/>
                <TextBlock Text="Application Settings" Style="{StaticResource TitleText}" VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="1" Margin="24">
            <Border Style="{StaticResource CardBorder}">
                <StackPanel>
                    <TextBlock Text="Cloud API base URL" Style="{StaticResource FieldLabelText}"/>
                    <TextBlock Name="CloudApiUrlTextBlock" FontFamily="Consolas" FontSize="12" Margin="0,0,0,14"/>

                    <TextBlock Text="Local database" Style="{StaticResource FieldLabelText}"/>
                    <TextBlock Name="DatabasePathTextBlock" FontFamily="Consolas" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,14"/>

                    <TextBlock Text="Raw device captures" Style="{StaticResource FieldLabelText}"/>
                    <TextBlock Name="CapturesPathTextBlock" FontFamily="Consolas" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,4"/>
                </StackPanel>
            </Border>

            <Border Background="{StaticResource BackgroundBrush}" CornerRadius="5" Padding="10,8" Margin="4,4,0,0">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE946;" Style="{StaticResource InlineIconText}" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Top" Margin="0,1,8,0"/>
                    <TextBlock Style="{StaticResource CaptionText}"
                               Text="These values are configured via appsettings.json and are shown here read-only for this MVP."/>
                </StackPanel>
            </Border>
        </StackPanel>
    </Grid>
</Window>
