<Window x:Class="CCMC.Desktop.Windows.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CCMC - Settings" Height="320" Width="480"
        WindowStartupLocation="CenterScreen">
    <StackPanel Margin="20">
        <TextBlock Text="Application Settings" FontSize="16" FontWeight="Bold" Margin="0,0,0,16"/>

        <TextBlock Text="Cloud API base URL"/>
        <TextBlock Name="CloudApiUrlTextBlock" FontFamily="Consolas" Margin="0,4,0,12"/>

        <TextBlock Text="Local database"/>
        <TextBlock Name="DatabasePathTextBlock" FontFamily="Consolas" Margin="0,4,0,12" TextWrapping="Wrap"/>

        <TextBlock Text="Raw device captures"/>
        <TextBlock Name="CapturesPathTextBlock" FontFamily="Consolas" Margin="0,4,0,12" TextWrapping="Wrap"/>

        <TextBlock Text="These values are configured via appsettings.json and are shown here read-only for this MVP."
                    Foreground="Gray" TextWrapping="Wrap" Margin="0,12,0,0"/>
    </StackPanel>
</Window>
