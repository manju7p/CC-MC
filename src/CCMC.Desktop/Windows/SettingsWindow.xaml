<Window x:Class="CCMC.Desktop.Windows.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CCMC - Settings" Height="380" Width="520"
        WindowStartupLocation="CenterScreen">
    <StackPanel Margin="24">
        <TextBlock Text="Application Settings" Style="{StaticResource TitleText}" Margin="0,0,0,16"/>

        <Border Style="{StaticResource CardBorder}">
            <StackPanel>
                <TextBlock Text="Cloud API base URL" Style="{StaticResource FieldLabelText}"/>
                <TextBlock Name="CloudApiUrlTextBlock" FontFamily="Consolas" FontSize="12" Margin="0,0,0,14"/>

                <TextBlock Text="Local database" Style="{StaticResource FieldLabelText}"/>
                <TextBlock Name="DatabasePathTextBlock" FontFamily="Consolas" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,14"/>

                <TextBlock Text="Raw device captures" Style="{StaticResource FieldLabelText}"/>
                <TextBlock Name="CapturesPathTextBlock" FontFamily="Consolas" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,4"/>
            </StackPanel>
        </Border>

        <TextBlock Style="{StaticResource CaptionText}" Margin="4,12,0,0"
                   Text="These values are configured via appsettings.json and are shown here read-only for this MVP."/>
    </StackPanel>
</Window>
