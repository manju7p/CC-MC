<Window x:Class="CCMC.Desktop.Windows.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CCMC - Sign In" Height="560" Width="460"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize">
    <Grid Background="{StaticResource SurfaceBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="150"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Brand band -->
        <Border Grid.Row="0" Background="{StaticResource PrimaryBrush}">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock Text="&#xE77B;" FontFamily="{StaticResource IconFontFamily}" FontSize="30"
                           Foreground="{StaticResource TextInverseBrush}" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                <TextBlock Text="CCMC" FontSize="26" FontWeight="Bold" Foreground="{StaticResource TextInverseBrush}"
                           HorizontalAlignment="Center"/>
                <TextBlock Text="Chilling Centre Milk Collection" FontSize="12" Foreground="{StaticResource PrimarySoftBrush}"
                           HorizontalAlignment="Center" Margin="0,4,0,0"/>
            </StackPanel>
        </Border>

        <!-- Sign-in card -->
        <Border Grid.Row="1" Style="{StaticResource CardBorder}" Margin="28,-24,28,28" VerticalAlignment="Top">
            <StackPanel Margin="8">
                <TextBlock Text="Sign in" Style="{StaticResource HeaderText}" Margin="0,0,0,4"/>
                <TextBlock Text="Use your operator, manager, or admin account." Style="{StaticResource CaptionText}" Margin="0,0,0,18"/>

                <!-- Error banner - hidden until LoginWindow.xaml.cs sets a message (see LoginButton_Click). -->
                <Border Name="ErrorBanner" Style="{StaticResource DangerChipBorder}" Padding="10,8" Margin="0,0,0,14" Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xEB90;" Style="{StaticResource DangerChipIcon}" FontSize="14" Margin="0,0,8,0"/>
                        <TextBlock Name="StatusTextBlock" Style="{StaticResource DangerChipText}" TextWrapping="Wrap" FontSize="12"/>
                    </StackPanel>
                </Border>

                <TextBlock Text="Email" Style="{StaticResource FieldLabelText}"/>
                <Grid Margin="0,0,0,14">
                    <TextBox Name="EmailTextBox" Padding="30,6,10,6"/>
                    <TextBlock Text="&#xE715;" Style="{StaticResource InlineIconText}" Foreground="{StaticResource TextMutedBrush}"
                               Margin="8,0,0,0" HorizontalAlignment="Left" IsHitTestVisible="False"/>
                </Grid>

                <TextBlock Text="Password" Style="{StaticResource FieldLabelText}"/>
                <Grid Margin="0,0,0,4">
                    <PasswordBox Name="PasswordBox" Padding="30,6,10,6"/>
                    <TextBlock Text="&#xE72E;" Style="{StaticResource InlineIconText}" Foreground="{StaticResource TextMutedBrush}"
                               Margin="8,0,0,0" HorizontalAlignment="Left" IsHitTestVisible="False"/>
                </Grid>

                <Button Name="LoginButton" Content="Sign In" Height="40" Style="{StaticResource PrimaryButton}"
                        Click="LoginButton_Click" IsDefault="True" Margin="0,18,0,0"/>

                <Border Background="{StaticResource BackgroundBrush}" CornerRadius="5" Padding="10,8" Margin="0,18,0,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE946;" Style="{StaticResource InlineIconText}" Foreground="{StaticResource TextMutedBrush}"
                                   VerticalAlignment="Top" Margin="0,1,8,0"/>
                        <TextBlock Name="OfflineHintTextBlock" Style="{StaticResource CaptionText}"
                                   Text="Sign-in works online (verified live against the cloud) or, if the cloud is unreachable, offline using credentials cached from your last successful online sign-in on this PC."/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>
    </Grid>
</Window>
