<Window x:Class="CCMC.Desktop.Windows.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CCMC - Sign In" Height="360" Width="420"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize">
    <StackPanel Margin="24">
        <TextBlock Text="Chilling Centre Milk Collection" FontSize="18" FontWeight="Bold" Margin="0,0,0,20"/>

        <TextBlock Text="Email" Margin="0,0,0,4"/>
        <TextBox Name="EmailTextBox" Margin="0,0,0,12" Height="26"/>

        <TextBlock Text="Password" Margin="0,0,0,4"/>
        <PasswordBox Name="PasswordBox" Margin="0,0,0,12" Height="26"/>

        <TextBlock Name="StatusTextBlock" Foreground="Red" TextWrapping="Wrap" Margin="0,0,0,12"/>

        <Button Name="LoginButton" Content="Sign In" Height="32" Click="LoginButton_Click"/>

        <TextBlock Name="OfflineHintTextBlock" Foreground="Gray" FontSize="11" Margin="0,16,0,0" TextWrapping="Wrap"
                   Text="Sign-in requires an internet connection to the cloud API. Offline sign-in is not yet supported - see CLAUDE.md."/>
    </StackPanel>
</Window>
