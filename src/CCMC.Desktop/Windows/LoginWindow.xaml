<Window x:Class="CCMC.Desktop.Windows.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CCMC - Sign In" Height="480" Width="440"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="120"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Brand band -->
        <Border Grid.Row="0" Background="{StaticResource PrimaryBrush}">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock Text="CCMC" FontSize="26" FontWeight="Bold" Foreground="{StaticResource TextInverseBrush}"
                           HorizontalAlignment="Center"/>
                <TextBlock Text="Chilling Centre Milk Collection" FontSize="12" Foreground="{StaticResource PrimarySoftBrush}"
                           HorizontalAlignment="Center" Margin="0,4,0,0"/>
            </StackPanel>
        </Border>

        <!-- Sign-in card -->
        <Border Grid.Row="1" Style="{StaticResource CardBorder}" Margin="28,-28,28,28" VerticalAlignment="Top">
            <StackPanel Margin="8">
                <TextBlock Text="Sign in" Style="{StaticResource HeaderText}" Margin="0,0,0,16"/>

                <TextBlock Text="Email" Style="{StaticResource FieldLabelText}"/>
                <TextBox Name="EmailTextBox" Margin="0,0,0,14"/>

                <TextBlock Text="Password" Style="{StaticResource FieldLabelText}"/>
                <PasswordBox Name="PasswordBox" Margin="0,0,0,10"/>

                <TextBlock Name="StatusTextBlock" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap"
                           FontSize="12" Margin="0,0,0,10"/>

                <Button Name="LoginButton" Content="Sign In" Height="38" Style="{StaticResource PrimaryButton}"
                        Click="LoginButton_Click" IsDefault="True"/>

                <TextBlock Name="OfflineHintTextBlock" Style="{StaticResource CaptionText}" Margin="0,16,0,0"
                           Text="Sign-in works online (verified live against the cloud) or, if the cloud is unreachable, offline using credentials cached from your last successful online sign-in on this PC."/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
