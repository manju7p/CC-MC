<Window x:Class="CCMC.Desktop.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CCMC - Dashboard" Height="480" Width="640"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Grid.Row="0" Margin="12" HorizontalAlignment="Right">
            <TextBlock Name="OfflineModeTextBlock" VerticalAlignment="Center" Margin="0,0,16,0"
                       Foreground="DarkOrange" FontWeight="Bold" Visibility="Collapsed"/>
            <Button Name="ReconnectButton" Content="Sign in online" Width="110" Margin="0,0,16,0"
                    Visibility="Collapsed" Click="ReconnectButton_Click"/>
            <TextBlock Name="WelcomeTextBlock" VerticalAlignment="Center" Margin="0,0,16,0"/>
            <Button Name="LogoutButton" Content="Logout" Width="80" Click="LogoutButton_Click"/>
        </StackPanel>

        <UniformGrid Grid.Row="1" Columns="3" Margin="24">
            <Button Content="Milk Reception" Margin="8" Height="64" Click="ReceptionButton_Click"/>
            <Button Content="Reception History" Margin="8" Height="64" Click="HistoryButton_Click"/>
            <Button Content="Sources" Margin="8" Height="64" Click="SourcesButton_Click"/>
            <Button Content="Vehicles" Margin="8" Height="64" Click="VehiclesButton_Click"/>
            <Button Content="Device Status" Margin="8" Height="64" Click="DeviceStatusButton_Click"/>
            <Button Content="Device Configuration" Margin="8" Height="64" Click="DeviceConfigButton_Click"/>
            <Button Content="Synchronization Status" Margin="8" Height="64" Click="SyncStatusButton_Click"/>
            <Button Content="Settings" Margin="8" Height="64" Click="SettingsButton_Click"/>
        </UniformGrid>

        <StatusBar Grid.Row="2">
            <StatusBarItem>
                <TextBlock Name="ConnectivityStatusTextBlock"/>
            </StatusBarItem>
            <Separator/>
            <StatusBarItem>
                <TextBlock Name="SyncStatusTextBlock"/>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
