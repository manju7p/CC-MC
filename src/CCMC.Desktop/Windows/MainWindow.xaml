<Window x:Class="CCMC.Desktop.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CCMC - Dashboard" Height="620" Width="960" MinHeight="480" MinWidth="720"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush1}" BorderThickness="0,0,0,1">
            <Grid Margin="20,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="CCMC" FontSize="18" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" VerticalAlignment="Center"/>
                    <TextBlock Text="Chilling Centre Milk Collection" Style="{StaticResource CaptionText}" Margin="10,4,0,0" VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                    <TextBlock Name="OfflineModeTextBlock" Foreground="{StaticResource WarningBrush}" FontWeight="Bold"
                               VerticalAlignment="Center" Margin="0,0,16,0"/>
                    <Button Name="ReconnectButton" Content="Sign in online" Style="{StaticResource SecondaryButton}"
                            Width="120" Margin="0,0,16,0" Visibility="Collapsed" Click="ReconnectButton_Click"/>
                    <TextBlock Name="WelcomeTextBlock" VerticalAlignment="Center" Margin="0,0,16,0" FontWeight="SemiBold"/>
                    <Button Name="LogoutButton" Content="Logout" Style="{StaticResource SecondaryButton}" Width="90" Click="LogoutButton_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Sidebar navigation -->
            <Border Grid.Column="0" Background="{StaticResource PrimaryDarkBrush}">
                <DockPanel LastChildFill="False" Margin="0,16,0,16">
                    <TextBlock DockPanel.Dock="Top" Text="NAVIGATION" FontSize="11" FontWeight="Bold"
                               Foreground="{StaticResource PrimarySoftBrush}" Margin="20,0,0,10"/>

                    <StackPanel DockPanel.Dock="Top">
                        <Button Content="Milk Reception" Style="{StaticResource SidebarButtonStyle}" Click="ReceptionButton_Click"/>
                        <Button Content="Reception History" Style="{StaticResource SidebarButtonStyle}" Click="HistoryButton_Click"/>
                        <Button Content="Sources" Style="{StaticResource SidebarButtonStyle}" Click="SourcesButton_Click"/>
                        <Button Content="Vehicles" Style="{StaticResource SidebarButtonStyle}" Click="VehiclesButton_Click"/>
                        <Button Content="Device Status" Style="{StaticResource SidebarButtonStyle}" Click="DeviceStatusButton_Click"/>
                        <Button Content="Device Configuration" Style="{StaticResource SidebarButtonStyle}" Click="DeviceConfigButton_Click"/>
                        <Button Content="Synchronization" Style="{StaticResource SidebarButtonStyle}" Click="SyncStatusButton_Click"/>
                        <Button Content="Settings" Style="{StaticResource SidebarButtonStyle}" Click="SettingsButton_Click"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Content: dashboard -->
            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="24">
                    <TextBlock Text="Today" Style="{StaticResource HeaderText}" Margin="0,0,0,14"/>

                    <UniformGrid Name="SummaryCardsPanel" Columns="4" Margin="0,0,0,20">
                        <Border Style="{StaticResource CardBorder}" Margin="0,0,10,0">
                            <StackPanel>
                                <TextBlock Text="RECEPTIONS" Style="{StaticResource SectionLabelText}"/>
                                <TextBlock Name="TodayTotalTextBlock" Text="—" Style="{StaticResource MetricValueText}" Margin="0,6,0,0"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource CardBorder}" Margin="0,0,10,0">
                            <StackPanel>
                                <TextBlock Text="ACCEPTED" Style="{StaticResource SectionLabelText}" Foreground="{StaticResource SuccessBrush}"/>
                                <TextBlock Name="TodayAcceptedTextBlock" Text="—" Style="{StaticResource MetricValueText}" Foreground="{StaticResource SuccessBrush}" Margin="0,6,0,0"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource CardBorder}" Margin="0,0,10,0">
                            <StackPanel>
                                <TextBlock Text="HOLD" Style="{StaticResource SectionLabelText}" Foreground="{StaticResource WarningBrush}"/>
                                <TextBlock Name="TodayHoldTextBlock" Text="—" Style="{StaticResource MetricValueText}" Foreground="{StaticResource WarningBrush}" Margin="0,6,0,0"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource CardBorder}">
                            <StackPanel>
                                <TextBlock Text="REJECTED" Style="{StaticResource SectionLabelText}" Foreground="{StaticResource DangerBrush}"/>
                                <TextBlock Name="TodayRejectedTextBlock" Text="—" Style="{StaticResource MetricValueText}" Foreground="{StaticResource DangerBrush}" Margin="0,6,0,0"/>
                            </StackPanel>
                        </Border>
                    </UniformGrid>

                    <TextBlock Name="DashboardUnavailableTextBlock" Style="{StaticResource CaptionText}" Margin="0,0,0,20" Visibility="Collapsed"/>

                    <TextBlock Text="System Status" Style="{StaticResource HeaderText}" Margin="0,0,0,14"/>
                    <UniformGrid Columns="2">
                        <Border Style="{StaticResource CardBorder}" Margin="0,0,10,0">
                            <StackPanel>
                                <TextBlock Text="DEVICES" Style="{StaticResource SectionLabelText}"/>
                                <TextBlock Name="ConnectivityStatusTextBlock" Margin="0,8,0,0" FontSize="13"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource CardBorder}">
                            <StackPanel>
                                <TextBlock Text="SYNCHRONIZATION" Style="{StaticResource SectionLabelText}"/>
                                <TextBlock Name="SyncStatusTextBlock" Margin="0,8,0,0" FontSize="13"/>
                            </StackPanel>
                        </Border>
                    </UniformGrid>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
