<Window x:Class="CCMC.Desktop.Windows.VehiclesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CCMC - Vehicles" Height="720" Width="880" MinHeight="520" MinWidth="660"
        WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <!-- Row card - same visual language as Reception History / Sources. Column widths
             mirror the header row below. -->
        <DataTemplate x:Key="VehicleRowTemplate">
            <Border Style="{StaticResource AlternatingRowBorder}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.6*" MinWidth="140"/>
                        <ColumnDefinition Width="2*" MinWidth="160"/>
                        <ColumnDefinition Width="1.2*" MinWidth="110"/>
                        <ColumnDefinition Width="1*" MinWidth="100"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding VehicleNumber}" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding TankerNumberText}" Style="{StaticResource CaptionText}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding DriverNameText}"/>
                        <TextBlock Text="{Binding DriverMobileText}" Style="{StaticResource CaptionText}"/>
                    </StackPanel>

                    <TextBlock Grid.Column="2" Text="{Binding CapacityText}" VerticalAlignment="Center" Style="{StaticResource CaptionText}"/>

                    <StackPanel Grid.Column="3" VerticalAlignment="Center">
                        <Border Style="{Binding StatusChipBorderStyle}" HorizontalAlignment="Left">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding StatusGlyph}" Style="{Binding StatusChipIconStyle}"/>
                                <TextBlock Text="{Binding StatusText}" Style="{Binding StatusChipTextStyle}"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource WindowHeaderBorder}">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#xE804;" Style="{StaticResource WindowHeaderIconText}"/>
                <StackPanel>
                    <TextBlock Text="Vehicles" Style="{StaticResource TitleText}"/>
                    <TextBlock Style="{StaticResource CaptionText}"
                               Text="Vehicles are managed in the cloud and cached locally for offline reception."/>
                </StackPanel>
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="24">

                <!-- Add Vehicle - visible only to users whose role grants VEHICLE_CREATE (Manager/Admin).
                     Client-side UX convenience only; the server independently enforces the same permission. -->
                <Border Name="AddVehiclePanel" Style="{StaticResource CardBorder}" Visibility="Collapsed">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <TextBlock Text="&#xE710;" Style="{StaticResource InlineIconText}" Foreground="{StaticResource PrimaryBrush}" Margin="0,0,6,0"/>
                            <TextBlock Text="ADD VEHICLE" Style="{StaticResource SectionLabelText}"/>
                        </StackPanel>

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Chilling Centre" Style="{StaticResource FieldLabelText}"/>
                                <ComboBox Name="AddVehicleCentreComboBox" DisplayMemberPath="Name"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Vehicle Number" Style="{StaticResource FieldLabelText}"/>
                                <TextBox Name="AddVehicleNumberTextBox"/>
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Tanker Number" Style="{StaticResource FieldLabelText}"/>
                                <TextBox Name="AddVehicleTankerNumberTextBox"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Capacity (kg)" Style="{StaticResource FieldLabelText}"/>
                                <TextBox Name="AddVehicleCapacityTextBox"/>
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Driver Name" Style="{StaticResource FieldLabelText}"/>
                                <TextBox Name="AddVehicleDriverNameTextBox"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Driver Mobile" Style="{StaticResource FieldLabelText}"/>
                                <TextBox Name="AddVehicleDriverMobileTextBox"/>
                            </StackPanel>
                        </Grid>

                        <Button Name="AddVehicleButton" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" Click="AddVehicleButton_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE710;" Style="{StaticResource InlineIconText}" Margin="0,0,6,0"/>
                                <TextBlock Text="Add Vehicle"/>
                            </StackPanel>
                        </Button>
                        <TextBlock Name="AddVehicleResultTextBlock" TextWrapping="Wrap" FontSize="12" Margin="0,10,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Search -->
                <Border Style="{StaticResource CardBorder}">
                    <Grid>
                        <TextBox Name="SearchTextBox" Style="{StaticResource SearchTextBox}" TextChanged="SearchTextBox_TextChanged"
                                 ToolTip="Search by vehicle number, tanker number, or driver" AutomationProperties.Name="Search vehicles"/>
                        <TextBlock Text="&#xE721;" Style="{StaticResource InlineIconText}" Foreground="{StaticResource TextMutedBrush}"
                                   Margin="10,0,0,0" HorizontalAlignment="Left" IsHitTestVisible="False"/>
                    </Grid>
                </Border>

                <Border Style="{StaticResource EmptyStateBorder}" Name="EmptyStatePanel" Visibility="Collapsed" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="&#xE804;" Style="{StaticResource EmptyStateIconText}"/>
                        <TextBlock Text="No vehicles found" Style="{StaticResource EmptyStateTitleText}"/>
                        <TextBlock Name="EmptyStateBodyTextBlock" Style="{StaticResource EmptyStateBodyText}"
                                   Text="No vehicles are cached for your accessible centre(s) yet. Sign in online to sync the latest master data."/>
                    </StackPanel>
                </Border>

                <StackPanel Name="ListPanel">
                    <!-- Column header labels - widths mirror VehicleRowTemplate above. -->
                    <Border Style="{StaticResource ListHeaderBorder}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.6*" MinWidth="140"/>
                                <ColumnDefinition Width="2*" MinWidth="160"/>
                                <ColumnDefinition Width="1.2*" MinWidth="110"/>
                                <ColumnDefinition Width="1*" MinWidth="100"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="VEHICLE" Style="{StaticResource SectionLabelText}"/>
                            <TextBlock Grid.Column="1" Text="DRIVER" Style="{StaticResource SectionLabelText}"/>
                            <TextBlock Grid.Column="2" Text="CAPACITY" Style="{StaticResource SectionLabelText}"/>
                            <TextBlock Grid.Column="3" Text="STATUS" Style="{StaticResource SectionLabelText}"/>
                        </Grid>
                    </Border>
                    <Border Style="{StaticResource ListContainerBorder}">
                        <ItemsControl Name="VehiclesItemsControl" ItemTemplate="{StaticResource VehicleRowTemplate}"/>
                    </Border>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
