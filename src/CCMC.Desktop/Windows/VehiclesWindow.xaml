<Window x:Class="CCMC.Desktop.Windows.VehiclesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CCMC - Vehicles" Height="440" Width="640"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" Margin="0,0,0,8"
                    Text="Vehicles are managed in the cloud and cached locally for offline reception (read-only here)."/>
        <DataGrid Grid.Row="1" Name="VehiclesGrid" AutoGenerateColumns="False" IsReadOnly="True">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Vehicle #" Binding="{Binding VehicleNumber}"/>
                <DataGridTextColumn Header="Tanker #" Binding="{Binding TankerNumber}"/>
                <DataGridTextColumn Header="Driver" Binding="{Binding DriverName}"/>
                <DataGridTextColumn Header="Mobile" Binding="{Binding DriverMobile}"/>
                <DataGridTextColumn Header="Capacity (kg)" Binding="{Binding CapacityKg}"/>
                <DataGridTextColumn Header="Status" Binding="{Binding Status}"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Window>
