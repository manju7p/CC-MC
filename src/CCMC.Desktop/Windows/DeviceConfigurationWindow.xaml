<Window x:Class="CCMC.Desktop.Windows.DeviceConfigurationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CCMC - Device Configuration" Height="640" Width="460"
        WindowStartupLocation="CenterScreen">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="20">
            <TextBlock Text="Device" Margin="0,0,0,4"/>
            <ComboBox Name="DeviceKindComboBox" Margin="0,0,0,12" SelectionChanged="DeviceKindComboBox_SelectionChanged"/>

            <TextBlock Text="Device / Vendor Name"/>
            <TextBox Name="NameTextBox" Margin="0,4,0,12"/>

            <TextBlock Text="COM Port"/>
            <Grid Margin="0,4,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <ComboBox Grid.Column="0" Name="ComPortComboBox" IsEditable="True" Margin="0,0,8,0"/>
                <Button Grid.Column="1" Name="RefreshPortsButton" Content="Refresh" Width="70" Click="RefreshPortsButton_Click"/>
            </Grid>

            <TextBlock Text="Baud Rate"/>
            <ComboBox Name="BaudRateComboBox" IsEditable="True" Margin="0,4,0,12"/>

            <TextBlock Text="Data Bits"/>
            <ComboBox Name="DataBitsComboBox" Margin="0,4,0,12"/>

            <TextBlock Text="Stop Bits"/>
            <ComboBox Name="StopBitsComboBox" DisplayMemberPath="Label" Margin="0,4,0,12"/>

            <TextBlock Text="Parity"/>
            <ComboBox Name="ParityComboBox" DisplayMemberPath="Label" Margin="0,4,0,12"/>

            <TextBlock Text="Flow Control"/>
            <ComboBox Name="FlowControlComboBox" DisplayMemberPath="Label" Margin="0,4,0,12"/>

            <TextBlock Text="Read Timeout (ms)"/>
            <TextBox Name="ReadTimeoutTextBox" Margin="0,4,0,12"/>

            <CheckBox Name="EnabledCheckBox" Content="Enabled" Margin="0,0,0,16"/>

            <UniformGrid Columns="2" Margin="0,0,0,8">
                <Button Name="TestConnectionButton" Content="Test Connection" Height="32" Margin="0,0,4,0" Click="TestConnectionButton_Click"/>
                <Button Name="SaveButton" Content="Save" Height="32" Margin="4,0,0,0" Click="SaveButton_Click"/>
            </UniformGrid>

            <TextBlock Name="StatusTextBlock" Foreground="Green" TextWrapping="Wrap" Margin="0,12,0,0"/>

            <TextBlock Foreground="Gray" FontSize="11" TextWrapping="Wrap" Margin="0,16,0,0"
                       Text="These are configurable serial settings per centre/device - COM4/2400/8-N-1 is only the verified default for the weighing scale, not a fixed requirement. A different chilling centre may use an entirely different COM port, baud rate, or device."/>
        </StackPanel>
    </ScrollViewer>
</Window>
