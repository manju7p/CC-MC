<Window x:Class="CCMC.Desktop.Windows.DeviceConfigurationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CCMC - Device Configuration" Height="720" Width="560" MinHeight="600" MinWidth="480"
        WindowStartupLocation="CenterOwner">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource WindowHeaderBorder}">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#xE713;" Style="{StaticResource WindowHeaderIconText}"/>
                <StackPanel>
                    <TextBlock Text="Device Configuration" Style="{StaticResource TitleText}"/>
                    <TextBlock Style="{StaticResource CaptionText}" MaxWidth="440"
                               Text="Configurable serial settings per centre/device - COM4/2400/8-N-1 is only the verified default for the weighing scale, not a fixed requirement."/>
                </StackPanel>
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="24">

                <Border Style="{StaticResource CardBorder}">
                    <StackPanel>
                        <TextBlock Text="DEVICE" Style="{StaticResource SectionLabelText}" Margin="0,0,0,12"/>
                        <TextBlock Text="Device" Style="{StaticResource FieldLabelText}"/>
                        <ComboBox Name="DeviceKindComboBox" Margin="0,0,0,14" SelectionChanged="DeviceKindComboBox_SelectionChanged"/>

                        <TextBlock Text="Device / Vendor Name" Style="{StaticResource FieldLabelText}"/>
                        <TextBox Name="NameTextBox" Margin="0,0,0,10"/>

                        <CheckBox Name="EnabledCheckBox" Content="Enabled"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardBorder}">
                    <StackPanel>
                        <TextBlock Text="SERIAL PARAMETERS" Style="{StaticResource SectionLabelText}" Margin="0,0,0,12"/>

                        <TextBlock Text="COM Port" Style="{StaticResource FieldLabelText}"/>
                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ComboBox Grid.Column="0" Name="ComPortComboBox" IsEditable="True" Margin="0,0,8,0"/>
                            <Button Grid.Column="1" Name="RefreshPortsButton" Style="{StaticResource SecondaryButton}" Click="RefreshPortsButton_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE72C;" Style="{StaticResource InlineIconText}" Margin="0,0,6,0"/>
                                    <TextBlock Text="Refresh"/>
                                </StackPanel>
                            </Button>
                        </Grid>

                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Baud Rate" Style="{StaticResource FieldLabelText}"/>
                                <ComboBox Name="BaudRateComboBox" IsEditable="True"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Data Bits" Style="{StaticResource FieldLabelText}"/>
                                <ComboBox Name="DataBitsComboBox"/>
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Stop Bits" Style="{StaticResource FieldLabelText}"/>
                                <ComboBox Name="StopBitsComboBox" DisplayMemberPath="Label"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Parity" Style="{StaticResource FieldLabelText}"/>
                                <ComboBox Name="ParityComboBox" DisplayMemberPath="Label"/>
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="Flow Control" Style="{StaticResource FieldLabelText}"/>
                        <ComboBox Name="FlowControlComboBox" DisplayMemberPath="Label" Margin="0,0,0,14"/>

                        <TextBlock Text="Read Timeout (ms)" Style="{StaticResource FieldLabelText}"/>
                        <TextBox Name="ReadTimeoutTextBox" Width="140"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardBorder}" Margin="0">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Name="TestConnectionButton" Height="36"
                                    Style="{StaticResource SecondaryButton}" Click="TestConnectionButton_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE895;" Style="{StaticResource InlineIconText}" Margin="0,0,6,0"/>
                                    <TextBlock Text="Test Connection"/>
                                </StackPanel>
                            </Button>
                            <Button Grid.Column="2" Name="SaveButton" Height="36"
                                    Style="{StaticResource PrimaryButton}" Click="SaveButton_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE73E;" Style="{StaticResource InlineIconText}" Margin="0,0,6,0"/>
                                    <TextBlock Text="Save"/>
                                </StackPanel>
                            </Button>
                        </Grid>
                        <TextBlock Name="StatusTextBlock" TextWrapping="Wrap" FontWeight="SemiBold" Margin="0,14,0,0"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
