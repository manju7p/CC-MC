<Window x:Class="CCMC.Desktop.Windows.SyncStatusWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CCMC - Synchronization Status" Height="340" Width="460"
        WindowStartupLocation="CenterScreen">
    <StackPanel Margin="24">
        <TextBlock Text="Synchronization Status" Style="{StaticResource TitleText}" Margin="0,0,0,16"/>

        <Border Style="{StaticResource CardBorder}">
            <StackPanel>
                <TextBlock Name="PendingTextBlock" FontWeight="SemiBold" Margin="0,0,0,10"/>
                <TextBlock Name="LastTickTextBlock" TextWrapping="Wrap" Style="{StaticResource CaptionText}" Margin="0,0,0,16"/>
                <Button Name="SyncNowButton" Content="Sync Now" Height="36" Style="{StaticResource PrimaryButton}" Click="SyncNowButton_Click"/>
                <TextBlock Name="NoSessionHintTextBlock" Foreground="{StaticResource WarningBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,14,0,0"/>
            </StackPanel>
        </Border>
    </StackPanel>
</Window>
