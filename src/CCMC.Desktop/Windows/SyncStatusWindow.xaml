<Window x:Class="CCMC.Desktop.Windows.SyncStatusWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CCMC - Synchronization Status" Height="280" Width="420"
        WindowStartupLocation="CenterScreen">
    <StackPanel Margin="20">
        <TextBlock Text="Synchronization Status" FontSize="16" FontWeight="Bold" Margin="0,0,0,16"/>
        <TextBlock Name="PendingTextBlock" Margin="0,0,0,8"/>
        <TextBlock Name="LastTickTextBlock" TextWrapping="Wrap" Margin="0,0,0,16"/>
        <Button Name="SyncNowButton" Content="Sync Now" Height="32" Click="SyncNowButton_Click"/>
        <TextBlock Name="NoSessionHintTextBlock" Foreground="DarkOrange" TextWrapping="Wrap" Margin="0,12,0,0"/>
    </StackPanel>
</Window>
