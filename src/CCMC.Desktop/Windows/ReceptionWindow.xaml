<Window x:Class="CCMC.Desktop.Windows.ReceptionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CCMC - Milk Reception" Height="900" Width="640" MinHeight="600" MinWidth="560"
        WindowStartupLocation="CenterScreen">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24">
            <TextBlock Text="Milk Reception" Style="{StaticResource TitleText}" Margin="0,0,0,18"/>

            <!-- Reception details -->
            <Border Style="{StaticResource CardBorder}">
                <StackPanel>
                    <TextBlock Text="RECEPTION DETAILS" Style="{StaticResource SectionLabelText}" Margin="0,0,0,12"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Chilling Centre" Style="{StaticResource FieldLabelText}"/>
                            <ComboBox Name="CentreComboBox" DisplayMemberPath="Name" Margin="0,0,0,10"
                                      SelectionChanged="CentreComboBox_SelectionChanged"/>
                            <TextBlock Text="Source" Style="{StaticResource FieldLabelText}"/>
                            <ComboBox Name="SourceComboBox" DisplayMemberPath="Name"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Vehicle" Style="{StaticResource FieldLabelText}"/>
                            <ComboBox Name="VehicleComboBox" DisplayMemberPath="VehicleNumber"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Devices -->
            <Border Style="{StaticResource CardBorder}">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="DEVICES" Style="{StaticResource SectionLabelText}" VerticalAlignment="Center"/>
                        <Button Grid.Column="1" Name="ReadDevicesButton" Content="Read Devices" Width="140" Height="34"
                                Style="{StaticResource PrimaryButton}" Click="ReadDevicesButton_Click"/>
                    </Grid>
                    <TextBlock Name="WeightStatusTextBlock" Style="{StaticResource CaptionText}" Margin="0,10,0,2"/>
                    <TextBlock Name="QualityStatusTextBlock" Style="{StaticResource CaptionText}" Margin="0,0,0,0"/>
                </StackPanel>
            </Border>

            <!-- Weight -->
            <Border Style="{StaticResource CardBorder}">
                <StackPanel>
                    <TextBlock Text="WEIGHT" Style="{StaticResource SectionLabelText}" Margin="0,0,0,10"/>
                    <TextBlock Text="Quantity (kg)" Style="{StaticResource FieldLabelText}"/>
                    <TextBox Name="QuantityTextBox" Width="180" FontSize="18" FontWeight="SemiBold"/>
                </StackPanel>
            </Border>

            <!-- Milk quality -->
            <Border Style="{StaticResource CardBorder}">
                <StackPanel>
                    <TextBlock Text="MILK QUALITY" Style="{StaticResource SectionLabelText}" Margin="0,0,0,12"/>

                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="FAT (%)" Style="{StaticResource FieldLabelText}"/>
                            <TextBox Name="FatTextBox"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="SNF (%)" Style="{StaticResource FieldLabelText}"/>
                            <TextBox Name="SnfTextBox"/>
                        </StackPanel>
                        <StackPanel Grid.Column="4">
                            <TextBlock Text="CLR / Density" Style="{StaticResource FieldLabelText}"/>
                            <TextBox Name="ClrTextBox"/>
                        </StackPanel>
                    </Grid>

                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Added Water (%)" Style="{StaticResource FieldLabelText}"/>
                            <TextBox Name="WaterTextBox"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Protein (%)" Style="{StaticResource FieldLabelText}"/>
                            <TextBox Name="ProteinTextBox"/>
                        </StackPanel>
                        <StackPanel Grid.Column="4">
                            <TextBlock Text="Temperature (°C)" Style="{StaticResource FieldLabelText}"/>
                            <TextBox Name="TemperatureTextBox"/>
                        </StackPanel>
                    </Grid>
                    <TextBlock Text="Temperature is not measured by the milk analyser - enter it manually." Style="{StaticResource CaptionText}" Margin="0,0,0,12"/>

                    <TextBlock Text="Raw analyser payload" Style="{StaticResource FieldLabelText}"/>
                    <TextBox Name="RawAnalyserPayloadTextBox" IsReadOnly="True" FontFamily="Consolas" FontSize="12"/>
                </StackPanel>
            </Border>

            <!-- Manual analyser test input -->
            <Border BorderBrush="{StaticResource WarningBrush}" BorderThickness="1.5" CornerRadius="6" Background="{StaticResource WarningSoftBrush}"
                    Padding="16" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="MILK ANALYSER — MANUAL TEST / DEVELOPMENT" FontSize="12" FontWeight="Bold"
                               Foreground="{StaticResource WarningBrush}" Margin="0,0,0,4"/>
                    <TextBlock Style="{StaticResource CaptionText}" Margin="0,0,0,10"
                               Text="Development/testing fallback ONLY - the physical Ekomilk KAM98-2A analyser is not connected. Type or paste the exact string the device would send (parentheses optional), e.g. (03900830283801210000032404503), then press Parse/Test. This feeds the SAME parser and fills the SAME fields above as a real device read would - it does not simulate a connected device."/>

                    <TextBlock Text="Raw analyser string" Style="{StaticResource FieldLabelText}"/>
                    <TextBox Name="ManualAnalyserInputTextBox" Margin="0,0,0,10" FontFamily="Consolas"/>
                    <Button Name="ParseManualAnalyserButton" Content="Parse / Test" Height="32" Width="140"
                            HorizontalAlignment="Left" Style="{StaticResource SecondaryButton}" Click="ParseManualAnalyserButton_Click"/>
                    <TextBlock Name="ManualAnalyserResultTextBlock" TextWrapping="Wrap" FontSize="12" Margin="0,10,0,0"/>
                </StackPanel>
            </Border>

            <!-- Quality decision -->
            <Border Style="{StaticResource CardBorder}">
                <StackPanel>
                    <TextBlock Text="QUALITY DECISION" Style="{StaticResource SectionLabelText}" Margin="0,0,0,4"/>
                    <TextBlock Style="{StaticResource CaptionText}" Margin="0,0,0,12"
                               Text="ACCEPT, HOLD, or REJECT is always an explicit operator decision - values within configured limits are never accepted automatically."/>

                    <TextBlock Text="Reason / notes (required for REJECT)" Style="{StaticResource FieldLabelText}"/>
                    <TextBox Name="DecisionReasonTextBox" Margin="0,0,0,14"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Name="AcceptButton" Grid.Column="0" Content="ACCEPT" Height="44"
                                Style="{StaticResource AcceptButtonStyle}" Click="AcceptButton_Click"/>
                        <Button Name="HoldButton" Grid.Column="2" Content="HOLD" Height="44"
                                Style="{StaticResource HoldButtonStyle}" Click="HoldButton_Click"/>
                        <Button Name="RejectButton" Grid.Column="4" Content="REJECT" Height="44"
                                Style="{StaticResource RejectButtonStyle}" Click="RejectButton_Click"/>
                    </Grid>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardBorder}" Margin="0">
                <TextBlock Name="ResultTextBlock" FontWeight="Bold" FontSize="14" TextWrapping="Wrap"/>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Window>
