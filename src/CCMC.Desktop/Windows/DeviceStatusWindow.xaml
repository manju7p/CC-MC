<Window x:Class="CCMC.Desktop.Windows.DeviceStatusWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CCMC - Device Status" Height="380" Width="520"
        WindowStartupLocation="CenterScreen">
    <StackPanel Margin="24">
        <TextBlock Text="Device Status" Style="{StaticResource TitleText}" Margin="0,0,0,16"/>

        <Border Style="{StaticResource CardBorder}">
            <StackPanel>
                <TextBlock Text="WEIGHING SCALE" Style="{StaticResource SectionLabelText}" Margin="0,0,0,8"/>
                <TextBlock Name="ScaleStateTextBlock" FontWeight="SemiBold" Margin="0,0,0,6"/>
                <TextBlock Name="ScaleDetailTextBlock" Style="{StaticResource CaptionText}" Margin="0,0,0,12"/>
                <Button Name="TestScaleButton" Content="Test Scale Connection" Height="32" HorizontalAlignment="Left" Width="180"
                        Style="{StaticResource SecondaryButton}" Click="TestScaleButton_Click"/>
            </StackPanel>
        </Border>

        <Border Style="{StaticResource CardBorder}">
            <StackPanel>
                <TextBlock Text="MILK ANALYSER" Style="{StaticResource SectionLabelText}" Margin="0,0,0,8"/>
                <TextBlock Name="AnalyserStateTextBlock" FontWeight="SemiBold" Margin="0,0,0,6"/>
                <TextBlock Name="AnalyserDetailTextBlock" Style="{StaticResource CaptionText}" Margin="0,0,0,12"/>
                <Button Name="TestAnalyserButton" Content="Test Analyser Connection" Height="32" HorizontalAlignment="Left" Width="180"
                        Style="{StaticResource SecondaryButton}" Click="TestAnalyserButton_Click"/>
            </StackPanel>
        </Border>
    </StackPanel>
</Window>
