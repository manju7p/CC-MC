<Window x:Class="CCMC.Desktop.Windows.DeviceStatusWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CCMC - Device Status" Height="460" Width="580" MinHeight="380" MinWidth="480"
        WindowStartupLocation="CenterOwner">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource WindowHeaderBorder}">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#xE975;" Style="{StaticResource WindowHeaderIconText}"/>
                <TextBlock Text="Device Status" Style="{StaticResource TitleText}" VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="24">
                <Border Style="{StaticResource CardBorder}">
                    <StackPanel>
                        <TextBlock Text="WEIGHING SCALE" Style="{StaticResource SectionLabelText}" Margin="0,0,0,10"/>
                        <StackPanel Name="ScaleStateHost" Orientation="Horizontal" Margin="0,0,0,8"/>
                        <TextBlock Name="ScaleDetailTextBlock" Style="{StaticResource CaptionText}" Margin="0,0,0,14"/>
                        <Button Name="TestScaleButton" HorizontalAlignment="Left"
                                Style="{StaticResource SecondaryButton}" Click="TestScaleButton_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE895;" Style="{StaticResource InlineIconText}" Margin="0,0,6,0"/>
                                <TextBlock Text="Test Scale Connection"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardBorder}">
                    <StackPanel>
                        <TextBlock Text="MILK ANALYSER" Style="{StaticResource SectionLabelText}" Margin="0,0,0,10"/>
                        <StackPanel Name="AnalyserStateHost" Orientation="Horizontal" Margin="0,0,0,8"/>
                        <TextBlock Name="AnalyserDetailTextBlock" Style="{StaticResource CaptionText}" Margin="0,0,0,14"/>
                        <Button Name="TestAnalyserButton" HorizontalAlignment="Left"
                                Style="{StaticResource SecondaryButton}" Click="TestAnalyserButton_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE895;" Style="{StaticResource InlineIconText}" Margin="0,0,6,0"/>
                                <TextBlock Text="Test Analyser Connection"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
