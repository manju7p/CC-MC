# Local Docker Compose environment - copy to `.env.local`, fill in a LOCAL
# password (anything, this never leaves your machine), then run:
#
#   docker compose -p cc-mc --env-file .env.local up -d --build
#
# `.env.local` is gitignored - never commit the real file, only this template.

ASPNETCORE_ENVIRONMENT=Development

# Host is the Compose service/container name (cc-mc-postgres), NEVER
# localhost - the API container reaches PostgreSQL over the Docker network,
# not the host loopback interface.
ConnectionStrings__CcmcDb=Host=cc-mc-postgres;Port=5432;Database=ccmc_cloud_docker;Username=ccmc_docker;Password=REPLACE_WITH_ANY_LOCAL_PASSWORD

# Any long random string is fine for local testing - generate one with
# `openssl rand -base64 48`. Do not reuse this value anywhere else.
Jwt__Secret=REPLACE_ME

# Matches ConnectionStrings__CcmcDb above - Compose passes these to the
# postgres:16 image directly (see compose.yaml).
POSTGRES_USER=ccmc_docker
POSTGRES_PASSWORD=REPLACE_WITH_ANY_LOCAL_PASSWORD
POSTGRES_DB=ccmc_cloud_docker

# Host-side port mappings (container-side ports are fixed at 8080/5432 -
# see compose.yaml). Change these only if they conflict with something
# else already running on your machine.
API_HOST_PORT=8081
POSTGRES_HOST_PORT=55433
