# Production (Neon PostgreSQL today; Render for the API is the NEXT step,
# not done yet) - copy to `.env.production`, fill in the REAL Neon
# connection string and a REAL random JWT secret, then either:
#
#   - run CCMC.Cloud.Api directly with these as real environment variables
#     (e.g. via `docker run --env-file .env.production ...` against the
#     cc-mc-api image, or `dotnet CCMC.Cloud.Api.dll` with them exported), or
#   - (once Render is deployed) set these as Render's own environment
#     variables in its dashboard - Render does not read this file.
#
# `.env.production` is gitignored - never commit the real file, and never
# paste the real Neon connection string into any tracked file, chat log,
# or documentation. Only this placeholder template is committed.

ASPNETCORE_ENVIRONMENT=Production

# Get this from the Neon console/CLI for the "production" branch of the
# fancy-cherry-25725711 project - Neon's own connection-string format
# (postgresql://user:password@host/db?sslmode=require) must be translated
# into Npgsql keyword form (see README.md "Configuration" for the exact
# mapping); the provider/driver is unchanged either way (Npgsql/EF Core).
ConnectionStrings__CcmcDb=Host=REPLACE_WITH_NEON_HOST;Port=5432;Database=REPLACE_ME;Username=REPLACE_ME;Password=REPLACE_ME;Ssl Mode=Require

# A real random secret, DIFFERENT from any local/dev value - generate with
# `openssl rand -base64 48` and store it only in a real secret manager /
# this gitignored file / Render's own environment variable UI once deployed.
Jwt__Secret=REPLACE_ME
